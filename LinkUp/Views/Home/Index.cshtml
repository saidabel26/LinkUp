@using LinkUp.Core.Domain.Common.Enums
@model LinkUp.Core.Application.ViewModels.Home.HomeViewModel
@{
    ViewData["Title"] = "Home";
    string me = (string)ViewBag.UserId;
}
@functions{
    public static string BuildYouTubeEmbed(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return string.Empty;
        try
        {
            var uri = new Uri(url);
            var host = uri.Host.ToLowerInvariant();
            string id = string.Empty;
            if (host.Contains("youtu.be"))
            {
                id = uri.AbsolutePath.Trim('/');
            }
            else
            {
                var q = uri.Query;
                if (!string.IsNullOrEmpty(q) && q.StartsWith("?"))
                {
                    var parts = q.Substring(1).Split('&', StringSplitOptions.RemoveEmptyEntries);
                    foreach (var p in parts)
                    {
                        var kv = p.Split('=', 2);
                        if (kv.Length >= 2 && kv[0] == "v") { id = kv[1]; break; }
                    }
                }
                if (string.IsNullOrEmpty(id) && uri.AbsolutePath.Contains("/shorts/"))
                {
                    id = uri.Segments.Last().Trim('/');
                }
            }
            return string.IsNullOrEmpty(id) ? string.Empty : $"https://www.youtube.com/embed/{id}";
        }
        catch { return string.Empty; }
    }
}
<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Crear publicación</h5>
                <form asp-action="CreatePost" method="post" enctype="multipart/form-data">
                    @if (TempData["Error"] is string err)
                    {
                        <div class="alert alert-danger">@err</div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Contenido (máx 1000 caracteres)</label>
                        <textarea name="Content" class="form-control" rows="3" maxlength="1000">@Model.Create.Content</textarea>
                        <span asp-validation-for="Create.Content" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tipo de medio</label>
                        <select id="mediaKind" name="MediaKind" class="form-select">
                            <option value="image">Imagen</option>
                            <option value="youtube">YouTube</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Imagen</label>
                        <input id="imageInput" name="Image" type="file" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Enlace de YouTube</label>
                        <input id="youtubeInput" name="YouTubeUrl" value="@Model.Create.YouTubeUrl" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary">Publicar</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <h5>Mis publicaciones</h5>
        @foreach (var p in Model.Posts)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <img src="@(p.AuthorProfilePhotoUrl ?? "/img/avatar.png")" class="rounded-circle me-2"
                            style="width:32px;height:32px;object-fit:cover" />
                        <div>
                            <div class="fw-semibold">@p.AuthorUserName</div>
                            <small class="text-muted">@p.CreatedAt.ToLocalTime()</small>
                        </div>
                    </div>
                    <div class="mb-2 d-flex">
                        <form asp-controller="Posts" asp-action="Edit" method="post" class="me-2 flex-grow-1">
                            <input type="hidden" name="Id" value="@p.Id" />
                            <div class="input-group">
                                <input name="Content" class="form-control form-control-sm" value="@p.Content" maxlength="1000" />
                                <button class="btn btn-sm btn-outline-primary" type="submit">Guardar</button>
                            </div>
                        </form>
                        <form asp-controller="Posts" asp-action="Delete" method="post">
                            <input type="hidden" name="id" value="@p.Id" />
                            <button class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('¿Está seguro de eliminar esta publicación?');">Eliminar</button>
                        </form>
                    </div>

                    @if (p.MediaType == MediaType.Image && !string.IsNullOrEmpty(p.ImageUrl))
                    {
                        <img src="@p.ImageUrl" class="img-fluid" />
                    }
                    else if (p.MediaType == MediaType.YouTube && !string.IsNullOrEmpty(p.YouTubeUrl))
                    {
                        var embed = BuildYouTubeEmbed(p.YouTubeUrl);
                        if (!string.IsNullOrEmpty(embed))
                        {
                            <div class="ratio ratio-16x9 mt-2">
                                <iframe src="@embed" title="YouTube video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                            </div>
                        }
                    }
                    <div class="mt-2">
                        @if (p.MyReaction == ReactionType.Like)
                        {
                            <span class="text-success me-2">Me gusta</span>
                            <form asp-action="React" asp-controller="Reactions" method="post" class="d-inline">
                                <input type="hidden" name="postId" value="@p.Id" />
                                <input type="hidden" name="type" value="Dislike" />
                                <button class="btn btn-sm btn-outline-danger">No me gusta</button>
                            </form>
                        }
                        else if (p.MyReaction == ReactionType.Dislike)
                        {
                            <form asp-action="React" asp-controller="Reactions" method="post" class="d-inline">
                                <input type="hidden" name="postId" value="@p.Id" />
                                <input type="hidden" name="type" value="Like" />
                                <button class="btn btn-sm btn-outline-success me-2">Me gusta</button>
                            </form>
                            <span class="text-danger">No me gusta</span>
                        }
                        else
                        {
                            <form asp-action="React" asp-controller="Reactions" method="post" class="d-inline">
                                <input type="hidden" name="postId" value="@p.Id" />
                                <input type="hidden" name="type" value="Like" />
                                <button class="btn btn-sm btn-outline-success me-2">Me gusta</button>
                            </form>
                            <form asp-action="React" asp-controller="Reactions" method="post" class="d-inline">
                                <input type="hidden" name="postId" value="@p.Id" />
                                <input type="hidden" name="type" value="Dislike" />
                                <button class="btn btn-sm btn-outline-danger">No me gusta</button>
                            </form>
                        }
                    </div>

                    <div class="mt-3">
                        <form asp-controller="Comments" asp-action="Create" method="post" class="mb-2">
                            <input type="hidden" name="PostId" value="@p.Id" />
                            <div class="input-group">
                                <input name="Content" class="form-control form-control-sm" placeholder="Escribe un comentario..." maxlength="750" />
                                <button class="btn btn-sm btn-outline-secondary" type="submit">Comentar</button>
                            </div>
                        </form>
                        @if (p.Comments.Any())
                        {
                            <div>
                                @foreach (var c in p.Comments)
                                {
                                    <div class="mb-2">
                                        <div class="d-flex align-items-center">
                                            <img src="@(c.AuthorProfilePhotoUrl ?? "/img/avatar.png")" class="rounded-circle me-2"
                                                style="width:26px;height:26px;object-fit:cover" />
                                            <div>
                                                <div class="fw-semibold">@c.AuthorUserName</div>
                                                <small class="text-muted">@c.CreatedAt.ToLocalTime()</small>
                                            </div>
                                        </div>
                                        <div class="ms-4">
                                            @if (c.UserId == me)
                                            {
                                                <div class="d-flex align-items-center">
                                                    <form asp-controller="Comments" asp-action="Edit" method="post" class="d-flex align-items-center me-2">
                                                        <input type="hidden" name="id" value="@c.Id" />
                                                        <input name="content" class="form-control form-control-sm me-2" value="@c.Content" maxlength="750" style="max-width: 420px;" />
                                                        <button class="btn btn-sm btn-outline-primary">Guardar</button>
                                                    </form>
                                                    <form asp-controller="Comments" asp-action="Delete" method="post">
                                                        <input type="hidden" name="id" value="@c.Id" />
                                                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                                                    </form>
                                                </div>
                                            }
                                            else
                                            {
                                                <div>@c.Content</div>
                                            }
                                        </div>
                                        <form asp-controller="Comments" asp-action="Create" method="post" class="ms-4 mt-1">
                                            <input type="hidden" name="PostId" value="@p.Id" />
                                            <input type="hidden" name="ParentCommentId" value="@c.Id" />
                                            <div class="input-group input-group-sm">
                                                <input name="Content" class="form-control form-control-sm" placeholder="Responder..." maxlength="750" />
                                                <button class="btn btn-sm btn-outline-secondary" type="submit">Responder</button>
                                            </div>
                                        </form>
                                        @if (c.Replies.Any())
                                        {
                                            <div class="ms-5 mt-1">
                                                @foreach (var r in c.Replies)
                                                {
                                                    <div class="mb-1">
                                                        <div class="d-flex align-items-center">
                                                            <img src="@(r.AuthorProfilePhotoUrl ?? "/img/avatar.png")" class="rounded-circle me-2"
                                                                style="width:22px;height:22px;object-fit:cover" />
                                                            <div>
                                                                <div class="fw-semibold">@r.AuthorUserName</div>
                                                                <small class="text-muted">@r.CreatedAt.ToLocalTime()</small>
                                                            </div>
                                                        </div>
                                                        <div class="ms-4">
                                                            @if (r.UserId == me)
                                                            {
                                                                <div class="d-flex align-items-center">
                                                                    <form asp-controller="Comments" asp-action="Edit" method="post" class="d-flex align-items-center me-2">
                                                                        <input type="hidden" name="id" value="@r.Id" />
                                                                        <input name="content" class="form-control form-control-sm me-2" value="@r.Content" maxlength="750" style="max-width: 420px;" />
                                                                        <button class="btn btn-sm btn-outline-primary">Guardar</button>
                                                                    </form>
                                                                    <form asp-controller="Comments" asp-action="Delete" method="post">
                                                                        <input type="hidden" name="id" value="@r.Id" />
                                                                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                                                                    </form>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div>@r.Content</div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const select = document.getElementById('mediaKind');
            const imgInput = document.getElementById('imageInput');
            const ytInput = document.getElementById('youtubeInput');

            function toggleInputs() {
                const kind = select.value;
                if (kind === 'image') {
                    // enable image, disable youtube
                    imgInput.disabled = false;
                    imgInput.required = true;
                    ytInput.disabled = true;
                    ytInput.required = false;
                    ytInput.value = '';
                } else if (kind === 'youtube') {
                    // enable youtube, disable image
                    ytInput.disabled = false;
                    ytInput.required = true;
                    imgInput.disabled = true;
                    imgInput.required = false;
                    try { imgInput.value = ''; } catch {}
                }
            }

            if (select && imgInput && ytInput) {
                select.addEventListener('change', toggleInputs);
                // Inicializar estado según valor por defecto
                toggleInputs();
            }
        })();
    </script>
}
