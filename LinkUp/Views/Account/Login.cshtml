@model LinkUp.Core.Application.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Login";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <h3>Iniciar sesión</h3>
        @if (TempData["AuthRequired"] is string ar)
        {
            <div class="alert alert-info">@ar</div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }
        @if (TempData["ConfirmMessage"] is string cm)
        {
            <div class="alert alert-info">@cm</div>
        }
        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label">Usuario</label>
                <input asp-for="UserName" class="form-control" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Entrar</button>
            <a asp-action="Register" class="btn btn-link">Registrarse</a>
            <a asp-action="ForgotPassword" class="btn btn-link">¿Olvidó su contraseña?</a>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
