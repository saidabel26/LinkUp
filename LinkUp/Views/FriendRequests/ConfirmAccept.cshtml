@model LinkUp.Core.Application.ViewModels.Friends.ConfirmFriendRequestViewModel
@{
    ViewData["Title"] = "Confirmar aceptación";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <p>¿Está seguro que desea aceptar la solicitud de amistad del usuario <strong>@Model.UserDisplay</strong>?</p>
                <form asp-action="Accept" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-success ms-2">Aceptar</button>
                </form>
            </div>
        </div>
    </div>
</div>
