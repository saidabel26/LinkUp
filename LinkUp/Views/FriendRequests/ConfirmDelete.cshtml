@model LinkUp.Core.Application.ViewModels.Friends.ConfirmFriendRequestViewModel
@{
    ViewData["Title"] = "Confirmar eliminación";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <p>¿Está seguro que desea eliminar la solicitud de amistad para <strong>@Model.UserDisplay</strong>?</p>
                <form asp-action="Delete" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary ms-2">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>
