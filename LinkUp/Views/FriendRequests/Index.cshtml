@model LinkUp.Core.Application.ViewModels.Friends.FriendRequestsIndexViewModel
@using LinkUp.Core.Application.Dtos.Identity
@{
    ViewData["Title"] = "Solicitudes de amistad";
}
<div class="row">
    <div class="col-md-6">
        <h5>Pendientes</h5>
        @foreach (var r in Model.Incoming)
        {
            var uid = r.FromUserId;
            Model.Profiles.TryGetValue(uid, out var u);
            <div class="card mb-2">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <img src="@(u?.ProfilePhotoUrl ?? "/img/avatar.png")" class="rounded-circle me-2" style="width:32px;height:32px;object-fit:cover" />
                        <div>
                            <div class="fw-semibold">@(u?.FullName ?? u?.UserName ?? uid)</div>
                            <small class="text-muted">@r.CreatedAt.ToLocalTime() - @r.CommonFriendsCount amigos en común</small>
                        </div>
                    </div>
                    <div>
                        <a asp-action="ConfirmAccept" asp-route-id="@r.Id" class="btn btn-sm btn-success">Aceptar</a>
                        <a asp-action="ConfirmReject" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger ms-1">Rechazar</a>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="col-md-6">
        <div class="d-flex justify-content-between align-items-center">
            <h5>Enviadas</h5>
            <a asp-action="New" class="btn btn-primary btn-sm">Nueva solicitud</a>
        </div>
        @foreach (var r in Model.Outgoing)
        {
            var uid = r.ToUserId;
            Model.Profiles.TryGetValue(uid, out var u);
            <div class="card mb-2">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <img src="@(u?.ProfilePhotoUrl ?? "/img/avatar.png")" class="rounded-circle me-2" style="width:32px;height:32px;object-fit:cover" />
                        <div>
                            <div class="fw-semibold">@(u?.FullName ?? u?.UserName ?? uid)</div>
                            <small class="text-muted">@r.CreatedAt.ToLocalTime() - @r.Status - @r.CommonFriendsCount amigos en común</small>
                        </div>
                    </div>
                    @if (r.Status == LinkUp.Core.Domain.Common.Enums.FriendRequestStatus.Pending)
                    {
                        <a asp-action="ConfirmDelete" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">Eliminar</a>
                    }
                </div>
            </div>
        }
    </div>
</div>
