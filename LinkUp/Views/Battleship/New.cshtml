@{
    ViewData["Title"] = "Nueva partida";
    var friends = (IEnumerable<(string userId, string userName, string? photo)>)ViewBag.Friends;
}
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="New" method="get" class="mb-3">
                    <div class="input-group">
                        <input type="text" name="q" value="@ViewBag.Search" class="form-control" placeholder="Buscar amigo..." />
                        <button class="btn btn-outline-secondary" type="submit">Buscar</button>
                    </div>
                </form>
                <form asp-action="Create" method="post">
                    <div class="list-group mb-3">
                        @foreach (var u in friends)
                        {
                            <div class="list-group-item d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center">
                                    <img src="@(u.photo ?? "/img/avatar.png")" class="rounded-circle me-2" style="width:32px;height:32px;object-fit:cover" />
                                    <div class="fw-semibold">@u.userName</div>
                                </div>
                                <input type="radio" name="opponentUserId" value="@u.userId" />
                            </div>
                        }
                        @if (!friends.Any())
                        {
                            <div class="list-group-item text-muted">No hay amigos disponibles.</div>
                        }
                    </div>
                    <a asp-action="Index" class="btn btn-secondary">Volver</a>
                    <button type="submit" class="btn btn-primary ms-2">Iniciar partida</button>
                </form>
            </div>
        </div>
    </div>
</div>
