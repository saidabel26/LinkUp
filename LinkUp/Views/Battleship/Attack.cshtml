@using LinkUp.Core.Application.Dtos.Battleship
@{
    ViewData["Title"] = "Tablero de ataque";
    var board = (BoardDto)ViewBag.Board;
    int gameId = (int)ViewBag.GameId;
    bool isMyTurn = (bool)ViewBag.IsMyTurn;
}
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                @if (!isMyTurn)
                {
                    <div class="alert alert-info">Es turno del oponente de atacar</div>
                }
                <div id="board" class="d-grid" style="grid-template-columns: repeat(12, 28px); gap: 4px;">
                    @for (int r = 0; r < board.Size; r++)
                    {
                        for (int c = 0; c < board.Size; c++)
                        {
                            var hit = board.MyAttacks.Any(a => a.Row == r && a.Col == c && a.IsHit);
                            var miss = board.MyAttacks.Any(a => a.Row == r && a.Col == c && !a.IsHit);
                            var bg = hit ? "#dc3545" : miss ? "#198754" : "#f8f9fa";
                            if (isMyTurn && !hit && !miss)
                            {
                                <form asp-action="DoAttack" method="post" style="display:inline-block">
                                    <input type="hidden" name="GameId" value="@gameId" />
                                    <input type="hidden" name="Row" value="@r" />
                                    <input type="hidden" name="Col" value="@c" />
                                    <button class="btn p-0" style="width:28px;height:28px;border:1px solid #dee2e6;background-color:@bg"></button>
                                </form>
                            }
                            else
                            {
                                <div style="width:28px;height:28px;border:1px solid #dee2e6;background-color:@bg"></div>
                            }
                        }
                    }
                </div>
                <div class="mt-3">
                    <a asp-action="Attack" asp-route-id="@gameId" class="btn btn-outline-secondary">Refrescar pantalla</a>
                    <a asp-action="Index" class="btn btn-secondary">Volver atrás</a>
                    <a asp-action="MyBoard" asp-route-id="@gameId" class="btn btn-outline-primary">Ver mi tablero</a>
                    <a asp-action="ConfirmResign" asp-route-id="@gameId" class="btn btn-outline-danger">Rendirse</a>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        (function() {
            const gameId = parseInt('@gameId', 10);
            const poll = async () => {
                try {
                    const res = await fetch('/Battleship/Status?id=' + gameId, { headers: { 'Accept': 'application/json' } });
                    if (!res.ok) return;
                    const data = await res.json();
                    if (data && data.ok && data.status === 'Finished') {
                        window.location.href = '/Battleship';
                        return;
                    }
                } catch { }
                setTimeout(poll, 3000);
            };
            setTimeout(poll, 3000);
        })();
    </script>
}
