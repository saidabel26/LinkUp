@{
    ViewData["Title"] = "Confirmar rendición";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <p>¿Está seguro que desea rendirse?</p>
                <form asp-action="Resign" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@ViewBag.GameId" />
                    <a asp-action="Attack" asp-route-id="@ViewBag.GameId" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger ms-2">Aceptar</button>
                </form>
            </div>
        </div>
    </div>
</div>
